#!/bin/sh
# Create the admin account the install asked for (ADMIN_USER/ADMIN_PASSWORD),
# once. Without it the only way in was `podman exec ... lnms user:add`.
# Runs every start but only acts while that user does not exist.

[ -n "${ADMIN_USER:-}" ] && [ -n "${ADMIN_PASSWORD:-}" ] || exit 0
: "${DB_HOST:=127.0.0.1}"
: "${DB_PORT:=3306}"

nc -z "$DB_HOST" "$DB_PORT" 2>/dev/null || {
    echo "[librenms] database not reachable; admin $ADMIN_USER not created"
    exit 0
}
grep -q "^INSTALL=true" /config/.env 2>/dev/null && exit 0

user_sql=$(printf '%s' "$ADMIN_USER" | sed "s/'/''/g")
count=$(mariadb -N -h "$DB_HOST" -P "$DB_PORT" -u "${DB_USERNAME:-librenms}" -p"${DB_PASSWORD:-}" \
    "${DB_DATABASE:-librenms}" -e "SELECT COUNT(*) FROM users WHERE username='$user_sql'" 2>/dev/null) || {
    echo "[librenms] users table not ready; admin $ADMIN_USER not created"
    exit 0
}
[ "$count" = "0" ] || exit 0

cd /usr/local/www/librenms || exit 0
LNMS="s6-setuidgid bsd ./lnms"
# The operator chose this password. LibreNMS's rules for passwords typed into
# its own UI (8+ characters, not in a known data leak) refused "admin" and
# "adminadmin" here and left no admin at all -- so they are lifted for this one
# command and put back after. Put back by value: `config:set <key>` with no
# value asks for confirmation, which is "no" without a terminal. config:get
# answers the default (true, 8) while nothing is set, so a fresh install ends
# up exactly where it started.
uncompromised=$($LNMS config:get password.uncompromised 2>/dev/null)
min_length=$($LNMS config:get password.min_length 2>/dev/null)
$LNMS config:set password.uncompromised false >/dev/null 2>&1
$LNMS config:set password.min_length 1 >/dev/null 2>&1
if out=$($LNMS user:add --role=admin --password="$ADMIN_PASSWORD" --no-interaction "$ADMIN_USER" 2>&1); then
    echo "[librenms] created admin user $ADMIN_USER"
else
    echo "$out"
    echo "[librenms] WARNING: could not create admin $ADMIN_USER -- see above; fix and restart"
fi
$LNMS config:set password.uncompromised "${uncompromised:-true}" >/dev/null 2>&1
$LNMS config:set password.min_length "${min_length:-8}" >/dev/null 2>&1
