# --------------------------------------------------------------------------

ARG BASE_VERSION=15.1
FROM ghcr.io/daemonless/nginx-base:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PKG_NAME="librenms"
ARG PACKAGES="${PKG_NAME} mariadb118-client fping rrdtool net-snmp python3 FreeBSD-mandoc"
ARG UPSTREAM_URL="https://api.github.com/repos/librenms/librenms/releases/latest"
ARG UPSTREAM_JQ=".tag_name"
ARG HEALTHCHECK_ENDPOINT="http://localhost:8080/daemonless-ping"

ENV HEALTHCHECK_URL="${HEALTHCHECK_ENDPOINT}" \
    LIBRENMS_USER="bsd"

# --- Metadata (Injected by Generator) ---
LABEL org.opencontainers.image.title="LibreNMS" \
      org.opencontainers.image.description="LibreNMS is an autodiscovering PHP/MySQL/SNMP based network monitoring which includes support for a wide range of network hardware and operating systems including Cisco, Linux, FreeBSD, Juniper, Brocade, Foundry, HP and many more." \
      org.opencontainers.image.source="https://github.com/daemonless/librenms" \
      org.opencontainers.image.url="https://www.librenms.org" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Monitoring" \
      io.daemonless.port="8080" \
      io.daemonless.volumes="/config" \
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.pkg-source="pkg" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
      io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}" \
      io.daemonless.packages="${PACKAGES}"

# Install librenms + php-fpm
# The librenms port installs to /usr/local/www/librenms
# storage/ is a symlink to /var/db/librenms/storage (we mount /config there)
RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    mkdir -p /app && \
    pkg query '%v' ${PKG_NAME} > /app/version && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/* && \
    rm -f /usr/local/etc/php-fpm.d/www.conf

# Installer DB host form: default to env DB_HOST instead of hardcoded 'localhost'
RUN sed -i '' "s/\$host ?? 'localhost'/\$host ?? env('DB_HOST', 'localhost')/" \
    /usr/local/www/librenms/resources/views/install/database.blade.php

# Install a logrotate config so LibreNMS validation doesn't warn (FreeBSD uses
# newsyslog, but the check just looks for the file's existence)
RUN mkdir -p /etc/logrotate.d && chmod 755 /etc/logrotate.d && \
    sed 's|/opt/librenms|/usr/local/www/librenms|g; s|su librenms librenms|su bsd bsd|g; s|librenms librenms|bsd bsd|g' \
        /usr/local/www/librenms/misc/librenms.logrotate > /etc/logrotate.d/librenms && \
    chmod 644 /etc/logrotate.d/librenms

# Use daemonless bsd user (uid/gid 1000) for librenms
RUN chown -R bsd:bsd /usr/local/www/librenms /var/db/librenms && \
    mkdir -p /var/log/librenms && \
    chown bsd:bsd /var/log/librenms

# Copy root filesystem
COPY root/ /

RUN chmod +x \
    /etc/services.d/nginx/run \
    /etc/services.d/php-fpm/run \
    /etc/services.d/dispatcher/run \
    /etc/services.d/scheduler/run \
    /etc/cont-init.d/10-librenms-env \
    /etc/cont-init.d/20-librenms-permissions \
    /etc/cont-init.d/25-librenms-nginx \
    /etc/cont-init.d/30-librenms-migrate \
    /etc/cont-init.d/40-librenms-config \
    /etc/cont-init.d/50-librenms-admin \
    /healthz

# --- Expose (Injected by Generator) ---
EXPOSE 8080

# --- Volumes (Injected by Generator) ---
VOLUME /config